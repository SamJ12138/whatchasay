# Backend configuration: every setting, with its default.
#
# Copy this file to backend/.env and uncomment what you change; an empty or missing
# .env means all defaults. The same names work as environment variables, which take
# precedence over .env. backend/.env is gitignored: API keys go there, never into the
# extension. Lists and objects are JSON. Relative paths are relative to backend/.
# backend/tests/test_env_example.py keeps this file in step with backend/app/config.py.

# ---- Translation engine ------------------------------------------------------
# opus = OPUS-MT on CPU (default) | hymt = Tencent HY-MT on an NVIDIA GPU, needs
# `python scripts/download_models.py --hymt --accept-hymt-license` | cloud = Google/Azure
# SUBTITLE_MT__ENGINE=opus
# Router order; empty = [engine] with opus behind it as the fallback (cloud is appended when enabled)
# SUBTITLE_MT__ENGINE_ORDER=[]
# HY-MT model file (Q4_K_M: 25-40% faster Bengali output than Q8_0, equivalent quality)
# SUBTITLE_MT__HYMT_GGUF=data/models/mt/HY-MT1.5-1.8B-Q4_K_M.gguf
# Hugging Face repo the download script fetches the GGUF from
# SUBTITLE_MT__HYMT_REPO=tencent/HY-MT1.5-1.8B-GGUF
# Layers offloaded to the GPU (-1 = all)
# SUBTITLE_MT__HYMT_GPU_LAYERS=-1
# llama-server context size per slot
# SUBTITLE_MT__HYMT_CTX=1024
# Maximum output tokens per HY-MT translation
# SUBTITLE_MT__HYMT_MAX_TOKENS=96
# llama-server slots (two target languages decode together)
# SUBTITLE_MT__HYMT_PARALLEL=2
# First start: seconds to wait for llama-server to load the model
# SUBTITLE_MT__HYMT_HEALTH_TIMEOUT_S=120.0
# A request that finds llama-server dead waits at most this long for the restarted one
# SUBTITLE_MT__HYMT_RESTART_TIMEOUT_S=20.0
# Warmup attempts before HY-MT is paused
# SUBTITLE_MT__HYMT_WARMUP_ATTEMPTS=3
# Pause between warmup attempts (doubles each time)
# SUBTITLE_MT__HYMT_WARMUP_BACKOFF_S=1.0
# After a failed start HY-MT is skipped this long, then tried again
# SUBTITLE_MT__HYMT_RETRY_INITIAL_S=15.0
# Cap for that doubling pause
# SUBTITLE_MT__HYMT_RETRY_MAX_S=300.0
# Target languages HY-MT is preferred for (others go to OPUS-MT)
# SUBTITLE_MT__HYMT_LANGUAGES=["en", "zh", "bn", "vi", "ja", "ko", "es", "fr", "de", "ru", "pt", "it", "ar", "hi"]

# ---- Translation: languages, line layout, OPUS-MT ----------------------------
# Default target languages (the extension usually sends its own per session)
# SUBTITLE_TRANSLATION__TARGET_LANGUAGES=["en", "zh"]
# Languages offered to the extension
# SUBTITLE_TRANSLATION__SUPPORTED_LANGUAGES=["en", "zh", "bn", "vi", "ja", "ko", "es", "fr", "de", "ru", "pt", "it"]
# Maximum lines per subtitle
# SUBTITLE_TRANSLATION__MAX_LINES=2
# Characters per line by language ("_default" for the rest)
# SUBTITLE_TRANSLATION__MAX_CHARS_BY_LANG={"en": 42, "vi": 42, "es": 42, "fr": 42, "de": 40, "pt": 42, "it": 42, "ru": 38, "zh": 22, "ja": 22, "ko": 22, "ar": 35, "hi": 38, "bn": 38, "_default": 40}
# Older per-language limits, used when MAX_CHARS_BY_LANG has no entry
# SUBTITLE_TRANSLATION__MAX_CHARS_EN=42
# SUBTITLE_TRANSLATION__MAX_CHARS_ZH=22
# SUBTITLE_TRANSLATION__MAX_CHARS_VI=42
# SUBTITLE_TRANSLATION__MAX_CHARS_DEFAULT=40
# Reading-speed limits (characters per second) used by the line breaker
# SUBTITLE_TRANSLATION__MAX_READING_SPEED_EN=25.0
# SUBTITLE_TRANSLATION__MAX_READING_SPEED_ZH=15.0
# cuda | cpu; default: cuda when an NVIDIA GPU is visible, else cpu
# SUBTITLE_TRANSLATION__DEVICE=cpu
# OPUS-MT model per direction: {"<src>": {"<tgt>": "<Hugging Face model>"}}; default: see backend/app/config.py
# SUBTITLE_TRANSLATION__OPUS_MODELS={...}
# Translate X->en->Y when no direct OPUS-MT model exists
# SUBTITLE_TRANSLATION__ALLOW_PIVOT=true
# Where converted (CTranslate2) OPUS-MT models live
# SUBTITLE_TRANSLATION__CT2_DIR=data/models/ct2
# OPUS-MT beam size
# SUBTITLE_TRANSLATION__OPUS_BEAM_SIZE=2
# OPUS-MT repetition penalty
# SUBTITLE_TRANSLATION__OPUS_REPETITION_PENALTY=1.2
# Never repeat an n-gram of this size (0 = off)
# SUBTITLE_TRANSLATION__OPUS_NO_REPEAT_NGRAM_SIZE=2
# Hard cap on output tokens
# SUBTITLE_TRANSLATION__OPUS_MAX_TOKENS=128
# Output tokens <= ratio x source tokens + 4 (stops a runaway decode; 0 = only the hard cap)
# SUBTITLE_TRANSLATION__OPUS_MAX_LENGTH_RATIO=3.0
# Target-language token for multi-target models
# SUBTITLE_TRANSLATION__OPUS_TARGET_TOKENS={"Helsinki-NLP/opus-mt-en-zh": ">>cmn_Hans<<", "Helsinki-NLP/opus-mt-de-ZH": ">>cmn_Hans<<"}

# ---- Language detection for page subtitles without a declared language -------
# Shorter Latin-script text uses the session's language hint instead of a guess
# SUBTITLE_LANG_DETECT__MIN_CHARS=24
# Longer text takes the detector's answer only at or above this probability
# SUBTITLE_LANG_DETECT__CONFIDENCE_FLOOR=0.9
# ...and only if it is one of these
# SUBTITLE_LANG_DETECT__CANDIDATE_LANGUAGES=["en", "zh", "bn", "vi", "ja", "ko", "es", "fr", "de", "ru", "pt", "it", "ar", "hi", "nl", "pl", "tr", "id"]
# Hint when neither the cue nor the tab declares a language
# SUBTITLE_LANG_DETECT__DEFAULT_HINT=en

# ---- Speech recognition (live captions) ---------------------------------------
# auto | sherpa-zipformer (the only engine)
# SUBTITLE_ASR__ENGINE=auto
# Where the speech models live
# SUBTITLE_ASR__MODELS_DIR=data/models/asr
# Mandarin model: bilingual (Apache-2.0, default) | large (no declared license; lower error
# rate on read Mandarin; `python scripts/download_models.py --mandarin-large --accept-mandarin-large-terms`)
# SUBTITLE_ASR__ZH_MODEL=bilingual
# Restore casing and punctuation of English speech before translation
# SUBTITLE_ASR__PUNCTUATION=true
# Where the punctuation model lives
# SUBTITLE_ASR__PUNCT_DIR=data/models/punct
# Spoken languages with streaming models (auto-detect chooses among these)
# SUBTITLE_ASR__LANGUAGES=["en", "zh", "bn"]
# CPU threads per recognizer
# SUBTITLE_ASR__NUM_THREADS=2
# Endpointing (seconds): reset after this much silence when no word was recognised yet
# SUBTITLE_ASR__RULE1_MIN_TRAILING_SILENCE=1.2
# End a sentence after this much silence following speech
# SUBTITLE_ASR__RULE2_MIN_TRAILING_SILENCE=0.6
# End it anyway after this long, even mid-sentence
# SUBTITLE_ASR__RULE3_MIN_UTTERANCE_LENGTH=10.0
# Seconds of voiced audio before spoken-language ID runs
# SUBTITLE_ASR__LID_WINDOW_S=2.5
# Minimum gap between partial captions (ms)
# SUBTITLE_ASR__PARTIAL_INTERVAL_MS=120
# Recognizers loaded at startup so a language switch is instant
# SUBTITLE_ASR__WARMUP_LANGUAGES=["en", "zh", "bn"]

# ---- Cloud providers (off by default; text leaves this computer when on) -----
# Master switch for cloud translation and the Groq/Gemini refiners
# SUBTITLE_CLOUD__ENABLED=false
# google | azure
# SUBTITLE_CLOUD__MT_PROVIDER=google
# SUBTITLE_CLOUD__GOOGLE_API_KEY=
# SUBTITLE_CLOUD__AZURE_TRANSLATOR_KEY=
# SUBTITLE_CLOUD__AZURE_TRANSLATOR_REGION=

# ---- Optional LLM refinement (a second, improved translation a moment later) --
# Off by default; a tab can still ask for it in the extension's settings
# SUBTITLE_REFINER__ENABLED=false
# ollama (local) | groq | gemini (cloud: also needs SUBTITLE_CLOUD__ENABLED=true)
# SUBTITLE_REFINER__PROVIDER=ollama
# A refinement later than this (seconds) is dropped
# SUBTITLE_REFINER__DEADLINE_S=0.8
# Target languages never refined (small LLMs degrade Bengali)
# SUBTITLE_REFINER__SKIP_LANGUAGES=["bn"]
# SUBTITLE_REFINER__GROQ_API_KEY=
# SUBTITLE_REFINER__GROQ_MODEL=llama-3.1-8b-instant
# SUBTITLE_REFINER__GEMINI_API_KEY=
# SUBTITLE_REFINER__GEMINI_MODEL=gemini-2.5-flash-lite
# Local Ollama server for provider=ollama
# SUBTITLE_OLLAMA__BASE_URL=http://localhost:11434
# SUBTITLE_OLLAMA__MODEL=qwen3:4b
# Seconds per Ollama request
# SUBTITLE_OLLAMA__TIMEOUT=30.0
# Previous subtitles given to the refiner as context
# SUBTITLE_OLLAMA__CONTEXT_WINDOW_SIZE=3

# ---- What is remembered -------------------------------------------------------
# Live-caption (audio) sessions write to the translation memory (default: never)
# SUBTITLE_TM__PERSIST_AUDIO_SESSIONS=false
# Page subtitles (caption mode) are kept in the translation memory
# SUBTITLE_TM__PERSIST_CAPTIONS=true
# Machine translations unused this many days are deleted at startup (0 = keep; corrections are kept)
# SUBTITLE_TM__RETENTION_DAYS=30
# In-memory translation cache: entries and seconds
# SUBTITLE_CACHE__MEMORY_CACHE_SIZE=1000
# SUBTITLE_CACHE__MEMORY_CACHE_TTL=3600
# The translation memory (SQLite)
# SUBTITLE_CACHE__TM_DATABASE_PATH=data/translation_memory.db
# Folder for runtime data
# SUBTITLE_DATA_DIR=data

# ---- Server -------------------------------------------------------------------
# Loopback only: anything else is refused
# SUBTITLE_SERVER__HOST=127.0.0.1
# SUBTITLE_SERVER__PORT=8765
# Accept the unpacked extension next to this backend (its id is derived from its folder)
# SUBTITLE_SERVER__ALLOW_LOCAL_EXTENSION=true
# More extension ids allowed to call the backend
# SUBTITLE_SERVER__EXTENSION_IDS=[]
# More origins allowed to call the backend
# SUBTITLE_SERVER__EXTRA_ORIGINS=[]
# Debug logging (also run.py --debug)
# SUBTITLE_SERVER__DEBUG=false
# WebSocket keepalive ping interval and timeout (seconds)
# SUBTITLE_SERVER__WS_PING_INTERVAL=30.0
# SUBTITLE_SERVER__WS_PING_TIMEOUT=10.0
# Translations running at once
# SUBTITLE_SERVER__MAX_CONCURRENT_TRANSLATIONS=5

# ---- Behaviour flags ------------------------------------------------------------
# Older name for SUBTITLE_REFINER__ENABLED (either one turns refinement on)
# SUBTITLE_FEATURES__USE_POST_EDITOR=false
# Session default for the extension's fast mode
# SUBTITLE_FEATURES__FAST_MODE=true
# Session default for the extension's strict meaning lock
# SUBTITLE_FEATURES__STRICT_MEANING_LOCK=true
# Load models at startup (off: they load on first use)
# SUBTITLE_FEATURES__WARMUP_ON_START=true
# Page-subtitle cues arriving within this many ms are translated in one batch
# SUBTITLE_FEATURES__BATCH_WINDOW_MS=30
# ...up to this many cues
# SUBTITLE_FEATURES__MAX_BATCH_SIZE=8
